# Generate real local values using python3 tools/init_env.py. No default credentials.
DJANGO_SECRET_KEY=
MFA_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
APP_BIND=127.0.0.1
APP_PORT=8088
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8088,http://localhost:8088
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Application policy is versioned in configuration/app.yaml.
APP_CONFIG_PATH=/app/configuration/app.yaml
APP_PROFILE=production
